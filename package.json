{
  "name": "xjtlu-knowledge-assistant",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run index:kb && next dev",
    "build": "npm run index:kb && next build",
    "start": "next start",
    "index:kb": "node scripts/build-article-index.mjs",
    "sync:kb": "npm run index:kb",
    "smoke:article-repository": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/smoke-test-article-repository.mts",
    "test:article-center": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-article-center.mts",
    "test:article-presentation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-article-presentation.mts",
    "test:client-id": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-client-id.mts",
    "translate:articles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/translate-articles.mts",
    "test:translation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-translation-pipeline.mts"
  },
  "dependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cytoscape": "^3.34.0",
    "docxtemplater": "^3.66.7",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "^15.5.0",
    "pizzip": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/pizzip": "^3.0.5",
    "typescript": "^5.7.0"
  }
}
