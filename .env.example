ANYTHINGLLM_BASE_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=replace-with-your-api-key

# Workspaces visible in the Demo selector.
ANYTHINGLLM_WORKSPACES={"西交利物浦大学":"xjtlu-official","西交利物浦大学图书馆":"xjtlu-sdg","西浦学生服务":"xjtlu-student-affairs"}

# Optional full公众号 source-account -> Workspace registry used by AnythingLLM sync.
# If omitted, sync falls back to ANYTHINGLLM_WORKSPACES.
# XJTLU_SOURCE_WORKSPACES={"西交利物浦大学":"xjtlu-official","西交利物浦大学图书馆":"xjtlu-sdg","西浦学生服务":"xjtlu-student-affairs","西浦就业CareerCentre":"xjtlu-careercentre"}

# Optional cross-source total Workspace. An article can be embedded into both
# its source Workspace and this all-sources Workspace.
# ANYTHINGLLM_ALL_WORKSPACE_SLUG=xjtlu-all-sources

# When true, a correctly identified source without a dedicated Workspace mapping
# may still sync into the all-sources Workspace. Empty/未分类 sources stay blocked.
XJTLU_SYNC_UNMAPPED_TO_ALL=false

# Active server Markdown corpus and generated unique-article index.
KB_MARKDOWN_ROOT=/mnt/sdd/knowledge-base/markdown
KB_INDEX_PATH=/mnt/sdd/xjtlu-sdg-llm/data/full-kb-index.json

# Lightweight sync registry. Stores hashes/status/doc IDs only; Markdown is not copied.
XJTLU_SYNC_DB=/mnt/sdd/knowledge-base/app-data/articles.db

# Optional path when the sync job should load a different env file.
# XJTLU_ENV_FILE=/mnt/sdd/xjtlu-sdg-llm/.env.local

# Optional Supabase research-feedback storage.
# Run supabase/feedback_schema.sql once in the target project, then configure these
# SERVER-SIDE variables. NEVER expose a secret/service-role key through NEXT_PUBLIC_*.
# SUPABASE_URL=https://your-project.supabase.co
# Preferred for newer Supabase projects:
# SUPABASE_SECRET_KEY=replace-with-server-side-secret-key
# Legacy-compatible fallback (use only if your project still provides it):
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
# SUPABASE_FEEDBACK_TABLE=demo_research_feedback

# Optional translation provider for article enrichment. "mock" is the safe, no-network default.
TRANSLATION_PROVIDER=mock
# Required only when TRANSLATION_PROVIDER=openai-compatible.
# TRANSLATION_API_BASE_URL=https://api.example.com/v1
# TRANSLATION_API_KEY=replace-with-server-side-api-key
# TRANSLATION_MODEL=replace-with-model-name
