ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=replace-with-your-api-key
# JSON map: visible account name -> AnythingLLM workspace slug
ANYTHINGLLM_WORKSPACES={"全部公众号":"xjtlu-all-sources","西交利物浦大学":"xjtlu-official","西交利物浦大学图书馆":"xjtlu-library"}
# Add the real slug of the third Workspace before running synchronization.
# Example key: "西浦学生服务":"xjtlu-student-services"
ADMIN_SYNC_TOKEN=replace-with-a-long-random-admin-token

# Full knowledge-base source and generated translation enrichment (server-side only)
KB_MARKDOWN_ROOT=/absolute/path/to/knowledge-base/markdown
KB_INDEX_PATH=/absolute/path/to/data/full-kb-index.json
KB_ENRICHMENT_ROOT=/absolute/path/to/writable/enrichment
