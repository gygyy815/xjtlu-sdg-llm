ANYTHINGLLM_BASE_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=replace-with-your-api-key

# JSON map: only these configured workspaces are shown in the Demo.
# The Demo also validates that each slug currently exists in AnythingLLM.
ANYTHINGLLM_WORKSPACES={"西交利物浦大学":"xjtlu-official","西交利物浦大学图书馆":"xjtlu-library","西浦学生服务":"xjtlu-student-affairs"}

# Server article repository. Configure this on the Huawei ECS deployment.
# Leave unset during local Windows UI development if the server repository is not mounted locally.
XJTLU_CONTENT_ROOT=/mnt/sdd/xjtlu-content

# Optional Python executable used by /api/server-sync/status.
# Linux default: python3; Windows default: python
# PYTHON_BIN=python3

# Legacy admin token. Keep only if an older /admin/sync route is still being used during migration.
# ADMIN_SYNC_TOKEN=replace-with-a-random-secret

# Optional translation provider for article enrichment. "mock" is the safe, no-network default.
TRANSLATION_PROVIDER=mock
# Required only when TRANSLATION_PROVIDER=openai-compatible.
# TRANSLATION_API_BASE_URL=https://api.example.com/v1
# TRANSLATION_API_KEY=replace-with-server-side-api-key
# TRANSLATION_MODEL=replace-with-model-name
